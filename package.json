  "description": "True solar time (真太阳时) in JavaScript: historical IANA offsets, daylight saving, longitude correction and the equation of time, with no dependencies.",
  "type": "module",
  "main": "./src/true-solar-time.js",
  "types": "./src/true-solar-time.d.ts",
  "exports": {
    ".": {

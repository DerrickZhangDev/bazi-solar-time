      "import": "./src/true-solar-time.js",
      "default": "./src/true-solar-time.js"
    }
  },
  "files": [
    "src",
    "test-vectors.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test.mjs"
  },
  "keywords": [
    "bazi",
    "four pillars",
    "true solar time",
    "chinese astrology",
    "equation of time",
    "timezone",
    "iana"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerrickZhangDev/bazi-solar-time.git"
  },
  "homepage": "https://bazipattern.com/true-solar-time",
  "engines": {
    "node": ">=18"
  }
}
